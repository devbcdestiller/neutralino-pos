{
  "applicationId": "js.neutralino.zero",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/dist",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*"
  ],
  "modes": {
    "window": {
      "title": "POS",
      "width": 1280,
      "height": 720,
      "minWidth": 640,
      "minHeight": 360,
      "icon": "/public/vite.svg"
    }
  },
  "cli": {
    "binaryName": "neutralinojs-zero",
    "resourcesPath": "/dist",
    "binaryVersion": "5.2.0",
    "frontendLibrary": {
      "patchFile": "/index.html",
      "devUrl": "http://localhost:3000",
      "projectPath": "/",
      "initCommand": "npm install",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build"
    }
  }
}